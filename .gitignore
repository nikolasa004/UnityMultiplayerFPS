/Assets/ScriptTemplates.meta
/Assets/TextMesh Pro/
/Assets/TextMesh Pro.meta

# Keep the Controller's Scripts (including Scripts/Components), not its other assets
/Assets/Controller/*
!/Assets/Controller/Scripts/
!/Assets/Controller/Scripts.meta

# Other third-party artwork / example prefab with unclear permission
/Assets/First Person Controller.prefab
/Assets/First Person Controller.prefab.meta
/Assets/PinClipart*
/Assets/pinpng*
