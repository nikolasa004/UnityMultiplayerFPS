*_clone_*/

# Asset Store resources with unverified redistribution permissions
/Assets/LowPolyFPSLite/
/Assets/LowPolyFPSLite.meta
/Assets/Pištolj/
/Assets/Pištolj.meta
/Assets/Efekti/
/Assets/Efekti.meta
/Assets/Standard Assets/
/Assets/Standard Assets.meta
/Assets/Zvukovi/
/Assets/Zvukovi.meta
